// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// Quy ước DB (MariaDB/Linux): snake_case — @@map cho bảng, @map cho cột
enum Role {
  ADMIN
  USER
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stories       Story[]
  refreshTokens RefreshToken[]
  blogPosts     BlogPost[]

  @@map("user")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_token")
}

enum ProjectStatus {
  COMPLETED
  IN_PROGRESS
  ARCHIVED
}

model Project {
  id         Int            @id @default(autoincrement())
  slug       String         @unique
  title      String
  badge      String?
  sumary     String?
  desc       String?        @db.Text
  longDesc   String?        @map("long_desc") @db.Text
  thumbnail  String?
  status     ProjectStatus  @default(IN_PROGRESS)
  isDisplay  Boolean        @default(true) @map("is_display")
  finishedAt DateTime?      @map("finished_at")
  demoUrl    String?        @map("demo_url")
  repoUrl    String?        @map("repo_url")
  featured   Boolean        @default(false)
  viewCount  Int            @default(0) @map("view_count")
  features   Json?
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  tags ProjectTag[]

  @@map("project")
}

model Tag {
  id        Int           @id @default(autoincrement())
  name      String        @unique
  slug      String        @unique
  projects  ProjectTag[]
  blogPosts BlogPostTag[]

  @@map("tag")
}

model ProjectTag {
  projectId Int     @map("project_id")
  tagId     Int     @map("tag_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
  @@map("project_tag")
}

model Story {
  id           String    @id @default(uuid())
  userId       Int       @map("user_id")
  mediaUrl     String    @map("media_url")
  thumbnailUrl String?   @map("thumbnail_url")
  mediaType    MediaType @default(IMAGE) @map("media_type")
  isPinned     Boolean   @default(false) @map("is_pinned")
  createdAt    DateTime  @default(now()) @map("created_at")
  expiresAt    DateTime  @map("expires_at")

  user  User        @relation(fields: [userId], references: [id])
  views StoryView[]

  @@index([userId, expiresAt])
  @@index([isPinned, createdAt])
  @@map("story")
}

model StoryView {
  id       String   @id @default(uuid())
  storyId  String   @map("story_id")
  viewerId String   @map("viewer_id")
  viewedAt DateTime @default(now()) @map("viewed_at")

  story Story @relation(fields: [storyId], references: [id])

  @@unique([storyId, viewerId])
  @@map("story_view")
}

enum MediaType {
  IMAGE
  VIDEO
}

model GalleryAsset {
  id           String    @id @default(uuid())
  title        String?
  alt          String?
  mediaUrl     String    @map("media_url")
  thumbnailUrl String?   @map("thumbnail_url")
  publicId     String?   @map("public_id")
  mediaType    MediaType @default(IMAGE) @map("media_type")
  folder       String?
  fileSize     Int?      @map("file_size")
  width        Int?
  height       Int?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([mediaType, createdAt])
  @@map("gallery_asset")
}

model SeoGlobalSettings {
  id                  Int      @id @default(1)
  siteName            String   @map("site_name")
  siteUrl             String   @map("site_url")
  tagline             String?  @db.VarChar(500)
  defaultTitle        String   @map("default_title")
  defaultDescription  String   @map("default_description") @db.Text
  defaultKeywords     String?  @map("default_keywords") @db.Text
  ogImageUrl          String?  @map("og_image_url")
  twitterSite         String?  @map("twitter_site")
  themeColor          String?  @default("#6366f1") @map("theme_color")
  ogLocale            String?  @default("vi_VN") @map("og_locale")
  organizationName    String?  @map("organization_name")
  organizationUrl     String?  @map("organization_url")
  organizationLogoUrl String?  @map("organization_logo_url")
  allowIndexing       Boolean  @default(true) @map("allow_indexing")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("seo_global_settings")
}

model SeoPageTemplate {
  id                  Int      @id @default(autoincrement())
  pageKey             String   @unique @map("page_key")
  label               String
  titleTemplate       String   @map("title_template")
  descriptionTemplate String   @map("description_template") @db.Text
  keywordsTemplate    String?  @map("keywords_template") @db.Text
  robots              String   @default("index, follow")
  ogImageUrl          String?  @map("og_image_url")
  isActive            Boolean  @default(true) @map("is_active")
  sortOrder           Int      @default(0) @map("sort_order")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("seo_page_template")
}

model ResumeSettings {
  id            Int      @id @default(1)
  content       Json?
  cvPdfUrl      String?  @map("cv_pdf_url")
  cvPdfFileName String?  @map("cv_pdf_file_name")
  cvPdfPublicId String?  @map("cv_pdf_public_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("resume_settings")
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model BlogCategoryDef {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  label       String
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  posts BlogPost[]

  @@map("blog_category")
}

model BlogPost {
  id           String         @id @default(uuid())
  slug         String         @unique
  title        String
  excerpt      String         @db.Text
  content      String         @db.LongText
  coverUrl     String?        @map("cover_url")
  categorySlug String         @default("tutorial") @map("category_slug")
  categoryRef  BlogCategoryDef @relation(fields: [categorySlug], references: [slug])
  status       BlogPostStatus @default(DRAFT)
  isDisplay   Boolean        @default(false) @map("is_display")
  featured    Boolean        @default(false)
  featuredOrder Int          @default(0) @map("featured_order")
  readMinutes Int            @default(5) @map("read_minutes")
  viewCount   Int            @default(0) @map("view_count")
  authorId    Int            @map("author_id")
  author      User           @relation(fields: [authorId], references: [id])
  publishedAt DateTime?      @map("published_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  tags BlogPostTag[]

  @@index([status, isDisplay, publishedAt])
  @@index([featured, publishedAt])
  @@map("blog_post")
}

model BlogPostTag {
  blogPostId String   @map("blog_post_id")
  tagId      Int      @map("tag_id")
  blogPost   BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([blogPostId, tagId])
  @@map("blog_post_tag")
}
